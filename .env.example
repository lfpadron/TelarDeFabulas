DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_PORT=8000

POSTGRES_DB=telar_fabulas
POSTGRES_USER=telar
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=2

EXPORT_PREVIEW_MAX_NODES=12
EXPORT_PREVIEW_MAX_WORDS=2500
EXPORT_SNAPSHOT_MAX_BYTES=20971520
EXPORT_SNAPSHOT_MAX_NODES=10000
EXPORT_READY_RETENTION_DAYS=7
EXPORT_FAILED_RETENTION_DAYS=7
EXPORT_MAX_ATTEMPTS=3
EXPORT_STALE_MINUTES=30
EXPORT_RETRY_BASE_SECONDS=60

PUBLIC_BASE_URL=http://localhost:8000
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=Telar de Fabulas <no-reply@localhost>
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

PRIVATE_MEDIA_ROOT=/code/private_media
CHARACTER_IMAGE_MAX_MB=5
